{
  "name": "quotation-studio-cf",
  "private": true,
  "description": "Cloudflare Worker + D1 for Quotation Studio (new project, not solar-epc-relay)",
  "scripts": {
    "sync": "node sync-public.js",
    "dev": "npm run sync && wrangler dev",
    "deploy": "npm run sync && wrangler deploy",
    "db:create": "wrangler d1 create quotation-studio-db",
    "db:schema": "wrangler d1 execute quotation-studio-db --remote --file=../schema.sql",
    "db:schema:local": "wrangler d1 execute quotation-studio-db --local --file=../schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
